generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  org       String?
  topic     String
  message   String
  createdAt DateTime @default(now())
  status    String   @default("new")

  @@index([createdAt])
  @@index([topic])
}

model DistrictMetric {
  id        String   @id @default(cuid())
  district  String
  farmers   Int
  yield     Float
  sensors   Int
  status    String
  updatedAt DateTime @default(now())

  @@unique([district])
}
